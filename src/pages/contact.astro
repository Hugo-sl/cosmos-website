---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Mail, MapPin, Send, ShieldCheck, Paintbrush } from '@lucide/astro';
---

<BaseLayout
  title="Contact & Acquisitions — Studio COSMOS"
  description="Contactez le studio de COSMOS pour toute demande d'acquisition d'œuvres, d'exposition, ou de projets monumentaux sur-mesure pour galeries et collectionneurs."
  currentPath="/contact"
>
  <!-- Header Contact -->
  <header class="py-16 sm:py-24 bg-[#F3F1EC] border-b border-hairline relative">
    <div class="max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16">
      <div class="max-w-4xl space-y-4">
        <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#8C7A5E] block font-bold">
          SERVICE AUX COLLECTIONNEURS & GALERIES
        </span>
        <h1 class="font-serif-display text-5xl sm:text-7xl lg:text-8xl text-[#141413] font-bold tracking-tight leading-[0.85]">
          Acquisitions & Studio
        </h1>
        <p class="font-serif-display italic text-2xl text-[#141413]">
          Vous êtes collectionneur, galeriste ou architecte d'intérieur ?
        </p>
        <p class="text-sm text-[#666460] leading-relaxed font-light max-w-2xl pt-2">
          Pour toute demande concernant la disponibilité d'une œuvre, l'organisation d'une exposition ou la réalisation de fresques monumentales sur-mesure, prenez contact directement avec le studio.
        </p>
      </div>
    </div>
  </header>

  <!-- Contact Form & Studio Details Grid -->
  <section class="py-20 lg:py-28 bg-[#F9F8F5]">
    <div class="max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Form Column (7 cols) -->
        <div class="lg:col-span-7 bg-[#F3F1EC] p-8 sm:p-12 border border-hairline">
          
          <h2 class="font-serif-display text-3xl text-[#141413] font-bold mb-6 pb-4 border-b border-hairline">
            Demande Directe au Studio
          </h2>

          <form action="#" method="POST" class="space-y-6">
            
            <!-- Nom & Prénom -->
            <div>
              <label for="full-name" class="block text-[10px] uppercase tracking-[0.2em] font-mono font-bold text-[#8C7A5E] mb-2">
                Nom & Prénom <span class="text-[#141413]">*</span>
              </label>
              <input
                type="text"
                id="full-name"
                name="name"
                required
                placeholder="Ex. Jean-Claude Mercer"
                class="w-full px-4 py-3.5 bg-[#F9F8F5] border border-hairline text-[#141413] placeholder-[#A09D96] text-sm focus:outline-none focus:border-[#141413] transition-colors"
              />
            </div>

            <!-- Qualité / Profile -->
            <div>
              <label for="user-profile" class="block text-[10px] uppercase tracking-[0.2em] font-mono font-bold text-[#8C7A5E] mb-2">
                Votre Qualité <span class="text-[#141413]">*</span>
              </label>
              <select
                id="user-profile"
                name="profile"
                required
                class="w-full px-4 py-3.5 bg-[#F9F8F5] border border-hairline text-[#141413] text-sm focus:outline-none focus:border-[#141413] transition-colors"
              >
                <option value="Collectionneur particulier">Collectionneur particulier</option>
                <option value="Galerie">Galerie d'Art / Curateur</option>
                <option value="Architecte">Architecte d'intérieur / Designer</option>
                <option value="Institution">Institution publique / Musée</option>
                <option value="Autre">Autre demande</option>
              </select>
            </div>

            <!-- Email -->
            <div>
              <label for="user-email" class="block text-[10px] uppercase tracking-[0.2em] font-mono font-bold text-[#8C7A5E] mb-2">
                Adresse E-mail <span class="text-[#141413]">*</span>
              </label>
              <input
                type="email"
                id="user-email"
                name="email"
                required
                placeholder="nom@exemple.com"
                class="w-full px-4 py-3.5 bg-[#F9F8F5] border border-hairline text-[#141413] placeholder-[#A09D96] text-sm focus:outline-none focus:border-[#141413] transition-colors"
              />
            </div>

            <!-- Subject / Artwork Preselection -->
            <div>
              <label for="subject-artwork" class="block text-[10px] uppercase tracking-[0.2em] font-mono font-bold text-[#8C7A5E] mb-2">
                Objet / Œuvre Souhaitée
              </label>
              <input
                type="text"
                id="subject-artwork"
                name="subject"
                placeholder="Ex. Demande de disponibilité pour 'The Wall' (2024)"
                class="w-full px-4 py-3.5 bg-[#F9F8F5] border border-hairline text-[#141413] placeholder-[#A09D96] text-sm focus:outline-none focus:border-[#141413] transition-colors"
              />
            </div>

            <!-- Message -->
            <div>
              <label for="user-message" class="block text-[10px] uppercase tracking-[0.2em] font-mono font-bold text-[#8C7A5E] mb-2">
                Votre Message / Projet <span class="text-[#141413]">*</span>
              </label>
              <textarea
                id="user-message"
                name="message"
                rows="5"
                required
                placeholder="Précisez la nature de votre projet ou vos questions concernant les pièces de l'artiste..."
                class="w-full px-4 py-3.5 bg-[#F9F8F5] border border-hairline text-[#141413] placeholder-[#A09D96] text-sm focus:outline-none focus:border-[#141413] transition-colors"
              ></textarea>
            </div>

            <!-- Submit Action -->
            <button
              type="submit"
              class="w-full inline-flex items-center justify-center gap-3 px-8 py-4 bg-[#141413] text-[#F9F8F5] text-xs font-mono uppercase tracking-[0.2em] font-bold hover:bg-[#8C7A5E] transition-colors duration-300"
            >
              <span>Transmettre la demande au studio</span>
              <Send class="w-4 h-4 text-[#F9F8F5]" aria-hidden="true" />
            </button>

          </form>
        </div>

        <!-- Studio Information & Reference Project Column (5 cols) -->
        <div class="lg:col-span-5 space-y-8">
          
          <!-- Studio Details -->
          <div class="bg-[#F3F1EC] p-8 border border-hairline space-y-6">
            <h3 class="font-serif-display text-2xl text-[#141413] font-bold">
              Coordonnées du Studio
            </h3>

            <div class="space-y-4 text-xs font-sans text-[#666460]">
              <div class="flex items-start gap-3">
                <MapPin class="w-4 h-4 text-[#8C7A5E] shrink-0 mt-0.5" aria-hidden="true" />
                <div>
                  <strong class="block text-[#141413]">ATELIER COSMOS</strong>
                  <span>Le Kremlin-Bicêtre (Grand Paris) — Sur rendez-vous uniquement</span>
                </div>
              </div>

              <div class="flex items-start gap-3">
                <Mail class="w-4 h-4 text-[#8C7A5E] shrink-0 mt-0.5" aria-hidden="true" />
                <div>
                  <strong class="block text-[#141413]">E-MAIL STUDIO</strong>
                  <a href="mailto:contact@cosmos-art.fr" class="hover:text-[#8C7A5E] underline">
                    contact@cosmos-art.fr
                  </a>
                </div>
              </div>
            </div>

            <div class="pt-4 border-t border-hairline flex items-center gap-2 text-[10px] font-mono text-[#666460]">
              <ShieldCheck class="w-4 h-4 text-[#8C7A5E]" aria-hidden="true" />
              <span>CERTIFICAT D'AUTHENTICITÉ INCLUS AVEC CHAQUE ŒUVRE</span>
            </div>
          </div>

          <!-- Highlight Upcoming Exhibition Banner -->
          <div class="bg-[#141413] text-[#F9F8F5] p-8 border border-hairline-dark space-y-4">
            <div class="flex items-center gap-2 text-[10px] uppercase font-mono tracking-widest text-[#8C7A5E] font-bold">
              <Paintbrush class="w-4 h-4" aria-hidden="true" />
              <span>PROCHAINE EXPOSITION</span>
            </div>
            <h4 class="font-serif-display text-2xl text-[#F9F8F5] font-bold">
              One By One
            </h4>
            <div class="text-xs font-mono text-[#C4B59D]">
              Bordeaux — Octobre 2026
            </div>
            <p class="text-xs text-[#9C9991] leading-relaxed font-light">
              Présentation d'une nouvelle série d'œuvres grand format.
            </p>
          </div>

        </div>

      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Fill subject input if URL query param 'oeuvre' is present
  const urlParams = new URLSearchParams(window.location.search);
  const oeuvreParam = urlParams.get('oeuvre');
  const subjectInput = document.getElementById('subject-artwork') as HTMLInputElement;

  if (oeuvreParam && subjectInput) {
    subjectInput.value = `Demande de renseignement pour l'œuvre : "${oeuvreParam}"`;
  }
</script>
