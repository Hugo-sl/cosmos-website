---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import ArtworkGrid from '../components/ArtworkGrid.astro';
import ArtisticApproachSection from '../components/ArtisticApproachSection.astro';
import AtelierSection from '../components/AtelierSection.astro';
import { ArrowUpRight } from '@lucide/astro';
---

<BaseLayout
  title="Monographie & Artbook Numérique"
  description="COSMOS — Peintre contemporain français. Du métro parisien en 1987 au dripping monumental. Catalogue officiel et collections d'œuvres uniques."
  currentPath="/"
>
  <!-- 1. Hero: Main Exhibition Entrance -->
  <Hero />

  <!-- 2. Manifesto: Curatorial Statement & Quote -->
  <Manifesto />

  <!-- 3. Featured Artworks Catalogue (Grid Selection) -->
  <ArtworkGrid
    limit={6}
    showFilters={false}
    title="Sélection d'Œuvres Majeures"
    subtitle="EXPOSITION PERMANENTE & COLLECTION 2023–2024"
  />

  <!-- CTA to full catalogue -->
  <div class="bg-[#F9F8F5] pb-20 text-center border-b border-hairline">
    <a
      href="/galerie"
      class="inline-flex items-center gap-3 px-8 py-4 bg-[#141413] text-[#F9F8F5] text-xs font-mono uppercase tracking-[0.22em] font-semibold hover:bg-[#8C7A5E] transition-colors"
    >
      <span>Explorer le catalogue complet (10 toiles)</span>
      <ArrowUpRight class="w-4 h-4" aria-hidden="true" />
    </a>
  </div>

  <!-- 4. Artistic Approach: The Dual Axis Technique -->
  <ArtisticApproachSection />

  <!-- 5. Atelier & Collector Services -->
  <AtelierSection />

</BaseLayout>
