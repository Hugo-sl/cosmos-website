---
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import imgVertical from '../assets/oeuvres/VARIOUS LETTERS.webp';
import imgHorizontal from '../assets/oeuvres/STONED-AGAIN.webp';
---

<section aria-labelledby="approach-title" class="py-24 sm:py-32 bg-[#F3F1EC] border-y border-hairline relative">
  <div class="max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16">
    
    <!-- Section Header -->
    <div class="mb-16">
      <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#8C7A5E] block font-bold mb-3">
        DISPOSITIF PICTURAL & PROCESSUS
      </span>
      <h2 id="approach-title" class="font-serif-display text-4xl sm:text-6xl lg:text-7xl text-[#141413] font-bold tracking-tight leading-[0.9]">
        La Tension des Deux Axes
      </h2>
    </div>

    <!-- Asymmetric 2-Column Content Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Column 1: Vertical Artwork Frame -->
      <div class="lg:col-span-5 relative">
        <div class="aspect-[3/4] bg-[#F9F8F5] border border-hairline overflow-hidden">
          <Image
            src={imgVertical}
            alt="COSMOS — Various Letters, exemple de l'axe vertical du graffiti"
            class="w-full h-full object-cover img-museum"
            width={700}
            height={933}
          />
        </div>
        <div class="mt-3 text-[10px] font-mono uppercase tracking-[0.18em] text-[#666460]">
          <span class="text-[#141413] font-bold">FIG. 10</span> — AXE VERTICAL · GRAFFITI & SIGNES
        </div>
      </div>

      <!-- Column 2: Narrative & Horizontal Dripping Frame -->
      <div class="lg:col-span-7 space-y-10 lg:pl-6">
        
        <div class="space-y-6 text-sm text-[#666460] font-light leading-relaxed">
          <p class="font-serif-display italic text-2xl text-[#141413] leading-snug">
            L’œuvre de COSMOS repose sur un rituel créatif à deux temps, où deux dimensions géométriques et culturelles s'affrontent.
          </p>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-8 border-t border-hairline pt-6">
            <div class="space-y-2">
              <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#8C7A5E] font-bold block">
                01. AXE VERTICAL — LE GRAFFITI
              </span>
              <p class="text-xs">
                Des lignes de force typographiques et des tags nerveux jetés sur la toile au chevalet, préservant l’urgence du geste et la mémoire des murs du métro parisien.
              </p>
            </div>

            <div class="space-y-2">
              <span class="text-[10px] font-mono uppercase tracking-[0.2em] text-[#8C7A5E] font-bold block">
                02. AXE HORIZONTAL — ACTION PAINTING
              </span>
              <p class="text-xs">
                La toile posée à plat accueille une chorégraphie physique où la peinture projetée vient recouvrir, bousculer ou pacifier la rigueur de la lettre.
              </p>
            </div>
          </div>
        </div>

        <!-- Horizontal Dripping Image Frame -->
        <div class="space-y-2">
          <div class="aspect-[16/9] bg-[#F9F8F5] border border-hairline overflow-hidden">
            <Image
              src={imgHorizontal}
              alt="COSMOS — Stoned Again, exemple de l'axe horizontal du dripping"
              class="w-full h-full object-cover img-museum"
              width={900}
              height={506}
            />
          </div>
          <div class="text-[10px] font-mono uppercase tracking-[0.18em] text-[#666460] text-right">
            <span class="text-[#141413] font-bold">FIG. 04</span> — AXE HORIZONTAL · DRIPPING & HUILE
          </div>
        </div>

        <a
          href="/a-propos"
          class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-[#141413] hover:text-[#8C7A5E] transition-colors border-b border-[#141413] pb-1 font-semibold"
        >
          <span>Lire l'essai curatorial complet</span>
          <ArrowUpRight class="w-4 h-4" aria-hidden="true" />
        </a>

      </div>

    </div>

  </div>
</section>
