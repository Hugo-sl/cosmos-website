---
import { ArrowUpRight, Menu, X, ChevronDown } from '@lucide/astro';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const isCurrent = (path: string): boolean => {
  if (path === '/' && currentPath === '/') return true;
  if (path !== '/' && currentPath.startsWith(path)) return true;
  return false;
};

const isGalerieActive = currentPath.startsWith('/galerie');
const isAccueilV2 = currentPath === '/accueil-v2';
const isAccueilV3 = currentPath === '/accueil-v3';
const isDarkHeader = isAccueilV2;

const getAccueilLabel = (): string => {
  if (isAccueilV2) return 'V2';
  if (isAccueilV3) return 'V3';
  return 'V1';
};

const getGalerieLabel = (): string => {
  if (currentPath === '/galerie-v2') return 'V2';
  if (currentPath === '/galerie-v3') return 'V3';
  if (currentPath === '/galerie-v4') return 'V4';
  return 'V1';
};
---

<header
  class={`fixed top-0 left-0 right-0 z-50 transition-all duration-300 ${
    isDarkHeader
      ? 'bg-transparent backdrop-blur-md border-b border-white/15 text-[#F9F8F5]'
      : 'bg-[#F9F8F5]/90 backdrop-blur-md border-b border-hairline text-[#141413]'
  }`}
>
  <div class="max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16 h-20 flex items-center justify-between">
    
    <!-- Brand Signature Logo -->
    <a href="/" class="flex items-center group py-1" aria-label="Accueil COSMOS">
      <svg
        version="1.0"
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 742 310"
        preserveAspectRatio="xMidYMid meet"
        class={`h-8 sm:h-9 w-auto transition-opacity group-hover:opacity-75 ${
          isDarkHeader ? 'fill-[#F9F8F5]' : 'fill-[#141413]'
        }`}
      >
        <g transform="translate(0.000000,310.000000) scale(0.100000,-0.100000)">
