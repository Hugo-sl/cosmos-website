---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { ArrowUpRight, ArrowDown, ChevronLeft, ChevronRight, Eye, Sparkles } from '@lucide/astro';

import imgTheWall from '../assets/oeuvres/THE-WALL.webp';
import imgCubaLibre from '../assets/oeuvres/CUBA-LIBRE.webp';
import imgSierraNevada from '../assets/oeuvres/SIERRA NEVADA 80X80.webp';
import imgStonedAgain from '../assets/oeuvres/STONED-AGAIN.webp';
import imgRomeoJuliette from '../assets/oeuvres/ROMEO-_-JULIETTE.webp';

const featuredArtworks = [
  {
    id: "the-wall",
    fig: "01",
    title: "The Wall",
    year: "2024",
    medium: "Technique mixte, spray aérosol & typographies sur lin",
    dimensions: "120 × 100 cm",
    status: "Disponible à l'Atelier",
    location: "Le Kremlin-Bicêtre",
    image: imgTheWall,
    phrase: "Confrontation physique entre strates typographiques urbaines et voiles de dripping.",
  },
  {
    id: "cuba-libre",
    fig: "02",
    title: "Cuba Libre",
    year: "2024",
    medium: "Acrylique, spray & dripping monumental",
    dimensions: "100 × 100 cm",
    status: "Collection Privée",
    location: "Bruxelles",
    image: imgCubaLibre,
    phrase: "L'énergie cinétique de la rue transfigurée dans un format d'une rare intensité picturale.",
  },
  {
    id: "sierra-nevada",
    fig: "03",
    title: "Sierra Nevada",
    year: "2024",
    medium: "Huile, spray & pigments purs sur toile",
    dimensions: "80 × 80 cm",
    status: "Disponible à l'Atelier",
    location: "Grand Paris",
    image: imgSierraNevada,
    phrase: "Une exploration de la matière brute et des pigments telluriques en strates successives.",
  },
  {
    id: "stoned-again",
    fig: "04",
    title: "Stoned Again",
    year: "2024",
    medium: "Collage urbain, déchirures & résine mate",
    dimensions: "100 × 100 cm",
    status: "Disponible à l'Atelier",
    location: "Grand Paris",
    image: imgStonedAgain,
    phrase: "Vestiges d'affiches lacérées et réécritures chromatiques sous tension continue.",
  },
  {
    id: "romeo-juliette",
    fig: "05",
    title: "Roméo & Juliette",
    year: "2024",
    medium: "Diptyque gestuel, aérosol & huile sur lin",
    dimensions: "140 × 100 cm",
    status: "Collection Privée",
    location: "Paris",
    image: imgRomeoJuliette,
    phrase: "Dialogue passionnel entre deux énergies chromatiques contraires sur lin brut.",
  },
];
---

<BaseLayout
  title="Accueil V2 — Immersion Picturale Plein Écran"
  description="Expérience d'immersion totale plein écran dans l'univers pictural de COSMOS. Action Painting & Street Art contemporain."
  currentPath="/accueil-v2"
>

  <!-- ═══════════════════════════════════════════════════════════════
       HERO SECTION — TOTAL ARTWORK IMMERSION (CONTEMPORARY GALLERY)
       ═══════════════════════════════════════════════════════════════ -->
  <section
    id="hero-v2"
    class="relative h-[100dvh] min-h-[620px] w-full overflow-hidden select-none bg-[#0a0a09]"
  >
    <!-- Full-Bleed Artwork Canvases with Ken Burns & Smooth Fade -->
    {featuredArtworks.map((art, idx) => (
      <div
        class={`hero-canvas-layer absolute inset-0 transition-opacity duration-1000 ease-[cubic-bezier(0.32,0.72,0,1)] ${
          idx === 0 ? 'opacity-100 z-1 pointer-events-auto' : 'opacity-0 z-0 pointer-events-none'
        }`}
        data-canvas-idx={idx}
      >
        <Image
          src={art.image}
          alt={`COSMOS — ${art.title}`}
          class="w-full h-full object-cover hero-kenburns"
          width={1920}
          height={1080}
          loading={idx === 0 ? "eager" : "lazy"}
          aria-hidden={idx !== 0}
        />
      </div>
    ))}

    <!-- Mouse-Following Gallery Spotlight -->
    <div id="hero-spotlight" class="absolute inset-0 z-10 pointer-events-none opacity-0 transition-opacity duration-700" />

    <!-- Ambient Shadow Layers (Calibrated to keep the center painting luminous) -->
    <div class="absolute inset-x-0 top-0 h-28 z-15 bg-gradient-to-b from-[#0a0a09]/50 via-[#0a0a09]/15 to-transparent pointer-events-none" />
    <div class="absolute inset-x-0 bottom-0 h-2/3 z-15 bg-gradient-to-t from-[#0a0a09]/90 via-[#0a0a09]/40 to-transparent pointer-events-none" />
    <div class="absolute inset-y-0 left-0 w-full sm:w-1/2 z-15 bg-gradient-to-r from-[#0a0a09]/50 via-transparent to-transparent pointer-events-none" />

    <!-- Top Curatorial Eyebrow & Pure Immersion Toggle (Floats under transparent navbar) -->
    <div id="hero-top-strip" class="absolute top-20 sm:top-24 left-0 right-0 z-25 px-6 sm:px-10 lg:px-16 pointer-events-none transition-opacity duration-500">
      <div class="max-w-[1600px] mx-auto flex items-center justify-between">
        <!-- Curatorial Tag -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-[#0a0a09]/40 backdrop-blur-md border border-white/10 text-[9px] sm:text-[10px] font-mono uppercase tracking-[0.22em] text-[#C4B59D]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#C4B59D] animate-pulse"></span>
          <span>Sélection Monographique · Immersion Plein Écran</span>
        </div>

        <!-- Mode Contemplation (Full Immersion toggle) -->
        <button
          id="btn-zen-mode"
          type="button"
          class="pointer-events-auto inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0a0a09]/40 hover:bg-[#0a0a09]/80 backdrop-blur-md border border-white/10 text-[10px] font-mono uppercase tracking-widest text-[#F9F8F5]/80 hover:text-white transition-all cursor-pointer group"
          title="Masquer les éléments d'interface pour contempler la toile seule"
        >
          <Eye class="w-3.5 h-3.5 text-[#C4B59D] group-hover:scale-110 transition-transform" />
          <span class="hidden sm:inline">Toile Seule</span>
        </button>
      </div>
    </div>

    <!-- Main Interactive Stage (Lower Region) -->
    <div id="hero-ui-container" class="relative z-30 h-full max-w-[1600px] mx-auto px-5 sm:px-10 lg:px-16 flex flex-col justify-end pb-6 sm:pb-10 pointer-events-none transition-all duration-500">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 lg:gap-8 items-end w-full">

        <!-- A. CURATORIAL FLOATING CARTEL (Double-Bezel Architecture) -->
        <div class="lg:col-span-7 pointer-events-auto">
          <div class="p-1 rounded-[1.75rem] bg-white/5 border border-white/10 shadow-[0_20px_60px_-15px_rgba(0,0,0,0.7)] backdrop-blur-2xl">
            <div class="p-5 sm:p-7 rounded-[calc(1.75rem-0.25rem)] bg-[#0E0D0C]/85 border border-white/10 space-y-3 sm:space-y-4">
              
              <!-- Cartel Header: Fig + Status -->
              <div class="flex items-center justify-between gap-3 border-b border-white/10 pb-2.5">
                <div class="flex items-center gap-2 sm:gap-2.5">
                  <span id="cartel-fig" class="text-[9px] sm:text-[10px] font-mono uppercase tracking-[0.25em] text-[#C4B59D] font-bold">
                    FIG. 01 / 05
                  </span>
                  <span class="text-white/20">·</span>
                  <span id="cartel-year" class="text-[9px] sm:text-[10px] font-mono text-[#9C9991]">
                    ÉDITION 2024
                  </span>
                </div>
                <span id="cartel-status" class="text-[8px] sm:text-[9px] font-mono uppercase tracking-[0.18em] px-2.5 py-0.5 rounded-full bg-white/10 text-[#F9F8F5] border border-white/10">
                  Disponible à l'Atelier
                </span>
              </div>

              <!-- Artwork Title & Phrase -->
              <div>
                <h1 id="cartel-title" class="font-serif-display text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[0.95] drop-shadow-sm transition-all duration-300">
                  The Wall
                </h1>
                <p id="cartel-phrase" class="font-serif-display italic text-xs sm:text-base lg:text-lg text-[#C4B59D] mt-1 sm:mt-1.5 font-normal line-clamp-2">
                  « Confrontation physique entre strates typographiques urbaines et voiles de dripping. »
                </p>
              </div>

              <!-- Medium & Dimensions Specs -->
              <div class="text-[10px] sm:text-xs font-mono text-[#9C9991] flex flex-wrap items-center gap-x-3 sm:gap-x-4 gap-y-1">
                <span id="cartel-medium">Technique mixte, spray aérosol & typographies sur lin</span>
                <span class="text-white/20 hidden sm:inline">|</span>
                <span id="cartel-dimensions" class="text-[#F9F8F5] font-bold">120 × 100 cm</span>
              </div>

              <!-- Button-in-Button CTA Action -->
              <div class="pt-1 sm:pt-2 flex flex-wrap items-center gap-3">
                <a
                  id="cartel-inquire-btn"
                  href="/contact?oeuvre=The%20Wall"
                  class="group relative inline-flex items-center gap-3 pl-5 pr-2 py-2 rounded-full bg-[#F9F8F5] text-[#141413] text-[11px] sm:text-xs font-mono uppercase tracking-[0.16em] font-bold hover:bg-[#C4B59D] active:scale-[0.98] transition-all duration-300 shadow-lg"
                >
                  <span>Acquérir cette œuvre</span>
                  <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#141413] text-[#F9F8F5] flex items-center justify-center group-hover:scale-105 group-hover:translate-x-0.5 transition-all">
                    <ArrowUpRight class="w-3.5 h-3.5 sm:w-4 sm:h-4" />
                  </span>
                </a>

                <a
                  href="/galerie"
                  class="inline-flex items-center gap-2 px-4 sm:px-5 py-2.5 rounded-full border border-white/20 text-[#F9F8F5] hover:bg-white/10 text-[11px] sm:text-xs font-mono uppercase tracking-[0.16em] transition-all"
                >
                  <span>Galerie Complète</span>
                </a>

                <a
                  href="#exhibition-details"
                  class="p-2.5 rounded-full border border-white/20 text-[#F9F8F5] hover:bg-white/10 transition-all ml-auto hidden sm:inline-flex items-center justify-center"
                  aria-label="Défiler vers l'exposition"
                  title="Découvrir la suite"
                >
                  <ArrowDown class="w-3.5 h-3.5" />
                </a>
              </div>

            </div>
          </div>
        </div>

        <!-- B. FLOATING MASTERPIECES THUMBNAILS DOCK (Bottom Right) -->
        <div class="lg:col-span-5 pointer-events-auto">
          <div class="p-2 sm:p-2.5 rounded-2xl bg-[#0E0D0C]/80 backdrop-blur-2xl border border-white/15 shadow-[0_20px_50px_rgba(0,0,0,0.5)] space-y-2">
            
            <!-- Dock Header: Controls -->
            <div class="flex items-center justify-between px-2 text-[9px] sm:text-[10px] font-mono uppercase tracking-widest text-[#9C9991]">
              <span class="text-[#C4B59D] font-bold flex items-center gap-1.5">
                <Sparkles class="w-3 h-3" />
                <span>Sélection d'Œuvres</span>
              </span>
              <div class="flex items-center gap-1.5">
                <button
                  id="btn-prev-art"
                  type="button"
                  aria-label="Œuvre précédente"
                  class="w-6 h-6 rounded-full border border-white/20 flex items-center justify-center text-white/70 hover:text-white hover:border-white transition-all cursor-pointer"
                >
                  <ChevronLeft class="w-3.5 h-3.5" />
                </button>
                <span id="dock-counter" class="text-white px-1 font-bold">01 / 05</span>
                <button
                  id="btn-next-art"
                  type="button"
                  aria-label="Œuvre suivante"
                  class="w-6 h-6 rounded-full border border-white/20 flex items-center justify-center text-white/70 hover:text-white hover:border-white transition-all cursor-pointer"
                >
                  <ChevronRight class="w-3.5 h-3.5" />
                </button>
              </div>
            </div>

            <!-- Thumbnails Horizontal Grid / Scroll -->
            <div class="flex items-center gap-2 sm:gap-2.5 overflow-x-auto pb-1 scrollbar-none">
              {featuredArtworks.map((art, idx) => (
                <button
                  type="button"
                  class={`art-thumb-btn group relative shrink-0 rounded-xl overflow-hidden transition-all duration-300 cursor-pointer border ${
                    idx === 0
                      ? 'w-16 h-13 sm:w-20 sm:h-16 border-[#C4B59D] ring-2 ring-[#C4B59D]/60 scale-100'
                      : 'w-13 h-11 sm:w-16 sm:h-13 border-white/20 opacity-60 hover:opacity-100 hover:border-white/50 scale-95'
                  }`}
                  data-art-index={idx}
                  aria-label={`Afficher ${art.title}`}
                >
                  <Image
                    src={art.image}
                    alt={art.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    width={120}
                    height={90}
                  />
                  <!-- Fig number pill on thumb -->
                  <span class="absolute top-1 left-1 px-1 py-0.2 rounded bg-black/80 text-[8px] font-mono text-[#F9F8F5]">
                    {art.fig}
                  </span>
                </button>
              ))}
            </div>

          </div>
        </div>

      </div>

    </div>

    <!-- Exit Fullscreen Toast (visible only when in Zen / Full-immersion mode) -->
    <div
      id="zen-mode-exit-hint"
      class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40 px-5 py-2.5 rounded-full bg-[#141413]/90 backdrop-blur-xl border border-white/20 text-[#F9F8F5] text-xs font-mono uppercase tracking-widest pointer-events-none opacity-0 transition-opacity duration-300 flex items-center gap-2 shadow-2xl"
    >
      <Eye class="w-3.5 h-3.5 text-[#C4B59D]" />
      <span>Cliquez n'importe où pour réafficher les détails</span>
    </div>

  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       2. EXHIBITION DETAILS SECTION
       ═══════════════════════════════════════════════════════════════ -->
  <section id="exhibition-details" class="py-16 sm:py-24 lg:py-32 bg-[#F9F8F5] border-b border-hairline">
    <div class="max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-6 space-y-4 sm:space-y-6">
          <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#8C7A5E] font-bold block">
            L'EXPÉRIENCE DU GESTE
          </span>
          <h2 class="font-serif-display text-3xl sm:text-5xl lg:text-6xl text-[#141413] font-bold tracking-tight leading-[0.95]">
            La Fusion des Deux Mondes
          </h2>
          <p class="text-xs sm:text-sm text-[#666460] font-light leading-relaxed">
            L'artiste aborde chaque toile comme un sanctuaire d'énergie. Des strates de bombes aérosol aux coulures à l'huile, l'œuvre capture l'urgence de la rue et la pérennité du musée.
          </p>
          <div class="pt-2">
            <a
              href="/a-propos"
              class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-[#141413] hover:text-[#8C7A5E] transition-colors border-b border-[#141413] pb-1 font-bold"
            >
              <span>Lire la biographie curatoriale</span>
              <ArrowUpRight class="w-3.5 h-3.5" aria-hidden="true" />
            </a>
          </div>
        </div>
        <div class="lg:col-span-6 grid grid-cols-2 gap-3 sm:gap-4 mt-4 lg:mt-0">
          <div class="aspect-[3/4] bg-[#F2F0EB] border border-hairline overflow-hidden">
            <Image src={imgCubaLibre} alt="COSMOS — Cuba Libre" class="w-full h-full object-cover img-museum" width={600} height={800} />
          </div>
          <div class="aspect-[3/4] bg-[#F2F0EB] border border-hairline overflow-hidden mt-4 sm:mt-8">
            <Image src={imgSierraNevada} alt="COSMOS — Sierra Nevada" class="w-full h-full object-cover img-museum" width={600} height={800} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       3. ATELIER & CONTACT CTA
       ═══════════════════════════════════════════════════════════════ -->
  <section class="py-16 sm:py-24 bg-[#141413] text-[#F9F8F5]">
    <div class="max-w-[1200px] mx-auto px-6 text-center space-y-6 sm:space-y-8">
      <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#8C7A5E] font-bold block">
        RÉSERVATIONS & GALERIES
      </span>
      <h2 class="font-serif-display text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight">
        Visite Privée de l'Atelier
      </h2>
      <p class="text-xs sm:text-sm text-[#9C9991] font-light max-w-xl mx-auto leading-relaxed">
        Découvrez les nouvelles créations en avant-première et étudiez la réalisation d'œuvres sur-mesure avec l'artiste.
      </p>
      <div class="pt-2 sm:pt-4">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2.5 sm:gap-3 px-6 sm:px-8 py-3.5 sm:py-4 bg-[#F9F8F5] text-[#141413] text-[11px] sm:text-xs font-mono uppercase tracking-[0.2em] font-bold hover:bg-[#8C7A5E] hover:text-[#F9F8F5] transition-colors"
        >
          <span>Prendre rendez-vous au studio</span>
          <ArrowUpRight class="w-3.5 h-3.5 sm:w-4 sm:h-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Ken Burns gentle continuous zoom on active canvas */
  @keyframes kenburns {
    0%   { transform: scale(1) translate(0, 0); }
    50%  { transform: scale(1.06) translate(-1%, -0.5%); }
    100% { transform: scale(1) translate(0, 0); }
  }
  .hero-kenburns {
    animation: kenburns 30s ease-in-out infinite;
  }
</style>

<script define:vars={{ featuredArtworks }}>
  // ── Artwork Gallery State ──
  let activeIndex = 0;
  const totalArtworks = featuredArtworks.length;
  let autoplayTimer = null;
  let isZenMode = false;

  const canvasLayers = document.querySelectorAll('.hero-canvas-layer');
  const thumbBtns = document.querySelectorAll('.art-thumb-btn');

  // DOM elements for curatorial cartel
  const cartelFig = document.getElementById('cartel-fig');
  const cartelYear = document.getElementById('cartel-year');
  const cartelStatus = document.getElementById('cartel-status');
  const cartelTitle = document.getElementById('cartel-title');
  const cartelPhrase = document.getElementById('cartel-phrase');
  const cartelMedium = document.getElementById('cartel-medium');
  const cartelDimensions = document.getElementById('cartel-dimensions');
  const cartelInquireBtn = document.getElementById('cartel-inquire-btn');
  const dockCounter = document.getElementById('dock-counter');

  const btnPrev = document.getElementById('btn-prev-art');
  const btnNext = document.getElementById('btn-next-art');
  const btnZen = document.getElementById('btn-zen-mode');
  const heroUiContainer = document.getElementById('hero-ui-container');
  const heroTopStrip = document.getElementById('hero-top-strip');
  const zenHint = document.getElementById('zen-mode-exit-hint');
  const heroSection = document.getElementById('hero-v2');

  function updateArtwork(index) {
    if (index < 0) index = totalArtworks - 1;
    if (index >= totalArtworks) index = 0;
    activeIndex = index;

    const data = featuredArtworks[activeIndex];

    // 1. Cross-fade Background Canvases
    canvasLayers.forEach((layer, i) => {
      if (i === activeIndex) {
        layer.classList.add('opacity-100', 'z-1', 'pointer-events-auto');
        layer.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
      } else {
        layer.classList.remove('opacity-100', 'z-1', 'pointer-events-auto');
        layer.classList.add('opacity-0', 'z-0', 'pointer-events-none');
      }
    });

    // 2. Update Thumbnails Dock Active State
    thumbBtns.forEach((btn, i) => {
      if (i === activeIndex) {
        btn.classList.add('w-16', 'h-13', 'sm:w-20', 'sm:h-16', 'border-[#C4B59D]', 'ring-2', 'ring-[#C4B59D]/60', 'scale-100');
        btn.classList.remove('w-13', 'h-11', 'sm:w-16', 'sm:h-13', 'border-white/20', 'opacity-60', 'scale-95');
      } else {
        btn.classList.remove('w-16', 'h-13', 'sm:w-20', 'sm:h-16', 'border-[#C4B59D]', 'ring-2', 'ring-[#C4B59D]/60', 'scale-100');
        btn.classList.add('w-13', 'h-11', 'sm:w-16', 'sm:h-13', 'border-white/20', 'opacity-60', 'scale-95');
      }
    });

    // 3. Update Curatorial Cartel Details
    if (cartelFig) cartelFig.textContent = `FIG. ${data.fig} / 05`;
    if (cartelYear) cartelYear.textContent = `ÉDITION ${data.year}`;
    if (cartelStatus) cartelStatus.textContent = data.status;
    if (cartelTitle) {
      cartelTitle.style.opacity = '0';
      cartelTitle.style.transform = 'translateY(6px)';
      setTimeout(() => {
        cartelTitle.textContent = data.title;
        cartelTitle.style.opacity = '1';
        cartelTitle.style.transform = 'translateY(0)';
      }, 150);
    }
    if (cartelPhrase) cartelPhrase.textContent = `« ${data.phrase} »`;
    if (cartelMedium) cartelMedium.textContent = data.medium;
    if (cartelDimensions) cartelDimensions.textContent = data.dimensions;
    if (cartelInquireBtn) cartelInquireBtn.setAttribute('href', `/contact?oeuvre=${encodeURIComponent(data.title)}`);
    if (dockCounter) dockCounter.textContent = `${data.fig} / 05`;
  }

  // Thumbnail buttons click
  thumbBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const idx = parseInt(btn.getAttribute('data-art-index') || '0', 10);
      updateArtwork(idx);
      resetAutoplay();
    });
  });

  // Previous / Next buttons
  if (btnPrev) {
    btnPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      updateArtwork(activeIndex - 1);
      resetAutoplay();
    });
  }
  if (btnNext) {
    btnNext.addEventListener('click', (e) => {
      e.stopPropagation();
      updateArtwork(activeIndex + 1);
      resetAutoplay();
    });
  }

  // Keyboard Navigation (Left / Right Arrow)
  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') {
      updateArtwork(activeIndex + 1);
      resetAutoplay();
    } else if (e.key === 'ArrowLeft') {
      updateArtwork(activeIndex - 1);
      resetAutoplay();
    }
  });

  // Autoplay cycle every 8 seconds
  function startAutoplay() {
    autoplayTimer = setInterval(() => {
      if (!isZenMode) {
        updateArtwork(activeIndex + 1);
      }
    }, 8000);
  }

  function resetAutoplay() {
    clearInterval(autoplayTimer);
    startAutoplay();
  }

  startAutoplay();

  // Pause on hover over controls
  if (heroUiContainer) {
    heroUiContainer.addEventListener('mouseenter', () => clearInterval(autoplayTimer));
    heroUiContainer.addEventListener('mouseleave', () => resetAutoplay());
  }

  // Zen Mode (Pure Immersion toggle)
  function toggleZenMode() {
    isZenMode = !isZenMode;
    if (isZenMode) {
      if (heroUiContainer) {
        heroUiContainer.style.opacity = '0';
        heroUiContainer.style.pointerEvents = 'none';
        heroUiContainer.style.transform = 'translateY(20px)';
      }
      if (heroTopStrip) heroTopStrip.style.opacity = '0';
      if (zenHint) zenHint.style.opacity = '1';
    } else {
      if (heroUiContainer) {
        heroUiContainer.style.opacity = '1';
        heroUiContainer.style.pointerEvents = 'auto';
        heroUiContainer.style.transform = 'translateY(0)';
      }
      if (heroTopStrip) heroTopStrip.style.opacity = '1';
      if (zenHint) zenHint.style.opacity = '0';
    }
  }

  if (btnZen) {
    btnZen.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleZenMode();
    });
  }

  // Clicking canvas when in Zen mode restores UI
  if (heroSection) {
    heroSection.addEventListener('click', () => {
      if (isZenMode) toggleZenMode();
    });
  }

  // Mouse-following museum spotlight
  const spotlight = document.getElementById('hero-spotlight');
  if (heroSection && spotlight) {
    heroSection.addEventListener('mouseenter', () => {
      spotlight.style.opacity = '1';
    });
    heroSection.addEventListener('mouseleave', () => {
      spotlight.style.opacity = '0';
    });
    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      spotlight.style.background = `radial-gradient(650px circle at ${x}px ${y}px, rgba(196,181,157,0.14), transparent 70%)`;
    });
  }
</script>
