---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { ArrowUpRight, Download, Calendar, MapPin, Award } from '@lucide/astro';

import imgCubaLibre from '../assets/oeuvres/CUBA-LIBRE.webp';
import imgSierraNevada from '../assets/oeuvres/SIERRA NEVADA 80X80.webp';

const timelineEvents = [
  {
    year: '1987',
    title: 'Les Origines Underground & Le Métro Parisien',
    description: 'Premier coup de bombe dans les entrailles du métro parisien. Naissance du blaze COSMOS dans la fureur et la spontanéité du mouvement graffiti originel.',
  },
  {
    year: '2019',
    title: 'La Révélation d’Assilah (Maroc)',
    description: 'Résidence artistique majeure à Assilah. Un virage chromatique marquant, infusé par la lumière méditerranéenne et l’intensité des pigments minéraux.',
  },
  {
    year: 'Aujourd’hui',
    title: 'Rayonnement & Collections Internationales',
    description: 'Présence en galeries permanentes et collections privées à Paris, Bruxelles, Strasbourg, Lille, Honfleur et Tanger.',
  },
];

const soloExhibitions = [
  { year: '2024', title: 'Cosmic Drift', location: 'Galerie d’Art Contemporain, Paris' },
  { year: '2023', title: 'Axe Vertical', location: 'Espace Culturel, Bruxelles' },
  { year: '2021', title: 'L’Énergie de la Rue', location: 'Galerie du Sud, Strasbourg' },
  { year: '2019', title: 'Lumières d’Assilah', location: 'Fondation Culturelle, Tanger' },
];

const groupExhibitions = [
  { year: '2024', title: 'Urban & Abstract Collision', location: 'Grand Palais Éphémère, Paris' },
  { year: '2022', title: 'Peinture Physique & Action Painting', location: 'Lille Art Fair, Lille' },
  { year: '2020', title: 'Génération Métro 80s', location: 'Pavillon des Arts, Honfleur' },
];
---

<BaseLayout
  title="À Propos & Démarche — COSMOS"
  description="Découvrez la démarche plastique et l'histoire de COSMOS, du métro parisien en 1987 à ses expositions internationales (Paris, Bruxelles, Tanger). CV d'artiste et dossier curatorial."
  currentPath="/a-propos"
>
  <!-- Header Monographie -->
  <header class="py-16 sm:py-24 bg-[#F3F1EC] border-b border-hairline relative">
    <div class="max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16">
      <div class="max-w-4xl space-y-6">
        <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#8C7A5E] block font-bold">
          ESSAI CURATORIAL & BIOGRAPHIE — ÉDITION 2026
        </span>
        <h1 class="font-serif-display text-5xl sm:text-7xl lg:text-8xl text-[#141413] font-bold tracking-tight leading-[0.85]">
          Du Métro Parisien aux Galeries
        </h1>
        
        <blockquote class="border-l-2 border-[#8C7A5E] pl-6 py-2 mt-4">
          <p class="font-serif-display italic text-xl sm:text-2xl text-[#141413] leading-relaxed">
            « "Cosmos" signifiant "Univers" en grec, l'artiste a fait de son nom une profession de foi : créer un langage pictural universel, capable d'émouvoir sans barrière de langue ni de culture. »
          </p>
        </blockquote>
      </div>
    </div>
  </header>

  <!-- Curatorial Essay Section (2-Columns Layout) -->
  <section class="py-20 lg:py-28 bg-[#F9F8F5] border-b border-hairline">
    <div class="max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        
        <!-- Text Column (7 cols) -->
        <article class="lg:col-span-7 space-y-8 text-sm text-[#666460] leading-relaxed font-light">
          
          <div class="space-y-4">
            <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-[#8C7A5E] block font-bold">
              LA GESTUELLE & LA MATIÈRE
            </span>
            <h2 class="font-serif-display text-3xl sm:text-4xl text-[#141413] font-bold">
              Une Généalogie du Geste
            </h2>
            <p class="text-base text-[#141413] font-normal leading-relaxed">
              L'artiste aborde la peinture comme une urgence physique. Formé dans l'effervescence de la scène urbaine parisienne des années 80, il a rapidement dépassé le cadre strict du mur pour amener la fureur du tag sur la toile de lin grand format.
            </p>
            <p>
              Son travail ne cherche pas à pacifier le chaos urbain, mais à en extraire la musique sacrée. Entre strates de bombes aérosol et coulures épaisses à l'huile, la matière devient le témoin vivant du temps qui s'accumule.
            </p>
          </div>

          <div class="bg-[#F3F1EC] p-8 border border-hairline space-y-4">
            <h3 class="font-serif-display text-2xl text-[#141413] font-bold">
              L’Héritage de l’Action Painting & du Pollock Dripping
            </h3>
            <p class="text-xs text-[#666460] leading-relaxed font-light">
              La toile n’est pas un espace passif de représentation, mais une arène de projection. En combinant la vitesse de la bombe aérosol avec les projections aléatoires de dripping inspirées de Jackson Pollock et Willem de Kooning, COSMOS crée des surfaces vibrantes à la limite de l’explosion.
            </p>
          </div>

          <p>
            Chaque œuvre s’inscrit dans un dialogue continu entre spontanéité instinctuelle et maîtrise de la composition, attirant l’œil du collectionneur dans les profondeurs insoupçonnées de la couche picturale.
          </p>

        </article>

        <!-- Visual Column (5 cols) -->
        <aside aria-label="Visualisation des travaux en atelier" class="lg:col-span-5 space-y-6">
          <div class="bg-[#F2F0EB] p-4 border border-hairline">
            <div class="aspect-[4/5] overflow-hidden border border-hairline">
              <Image
                src={imgCubaLibre}
                alt="COSMOS — Cuba Libre (2024)"
                class="w-full h-full object-cover img-museum"
                width={600}
                height={750}
              />
            </div>
            <div class="mt-3 text-[10px] font-mono text-[#666460] flex justify-between uppercase">
              <span class="text-[#141413] font-bold">CUBA LIBRE (2024)</span>
              <span>COLLECTION PRIVÉE</span>
            </div>
          </div>
        </aside>

      </div>
    </div>
  </section>

  <!-- Chronology & Key Milestones Section -->
  <section aria-labelledby="timeline-title" class="py-20 lg:py-28 bg-[#F3F1EC] border-b border-hairline">
    <div class="max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16">
      
      <div class="mb-16 border-b border-hairline pb-6 flex items-end justify-between">
        <div>
          <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-[#8C7A5E] block font-bold mb-2">
            REPÈRES CHRONOLOGIQUES
          </span>
          <h2 id="timeline-title" class="font-serif-display text-4xl sm:text-5xl text-[#141413] font-bold">
            Synthèse du Parcours
          </h2>
        </div>
        <span class="text-xs font-mono text-[#666460]">1987–2026</span>
      </div>

      <!-- Timeline 3-Columns Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {timelineEvents.map((event, idx) => (
          <div class="bg-[#F9F8F5] p-8 border border-hairline flex flex-col justify-between space-y-6">
            <div class="space-y-3">
              <span class="font-serif-display text-4xl font-bold text-[#8C7A5E] block">
                {event.year}
              </span>
              <h3 class="font-serif-display text-xl text-[#141413] font-bold">
                {event.title}
              </h3>
              <p class="text-xs text-[#666460] leading-relaxed font-light">
                {event.description}
              </p>
            </div>

            <div class="pt-4 border-t border-hairline text-[10px] font-mono text-[#666460] flex items-center gap-1">
              <MapPin class="w-3.5 h-3.5 text-[#8C7A5E]" aria-hidden="true" />
              <span>COSMOS ARCHIVES</span>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Official Curriculum Vitae (CV) Section -->
  <section aria-labelledby="cv-title" class="py-20 lg:py-28 bg-[#F9F8F5]">
    <div class="max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
        
        <!-- CV Sidebar Info -->
        <div class="lg:col-span-4 space-y-6">
          <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-[#8C7A5E] block font-bold">
            CURRICULUM VITÆ
          </span>
          <h2 id="cv-title" class="font-serif-display text-4xl text-[#141413] font-bold">
            Expositions & Rayonnement
          </h2>
          <p class="text-xs text-[#666460] leading-relaxed font-light">
            Dossier d'artiste complet avec cotation et rétrospective disponible sur demande pour les conservateurs, galeries et conseillers en art.
          </p>

          <a
            href="/contact"
            class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.18em] px-6 py-3 bg-[#141413] text-[#F9F8F5] font-semibold hover:bg-[#8C7A5E] transition-colors"
          >
            <Download class="w-4 h-4 text-[#8C7A5E]" aria-hidden="true" />
            <span>Demander le Dossier d'Artiste (PDF)</span>
          </a>
        </div>

        <!-- Solo & Group Exhibitions Lists -->
        <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-8">
          
          <!-- Solo Shows -->
          <div class="space-y-4">
            <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-[#8C7A5E] font-bold border-b border-hairline pb-2">
              EXPOSITIONS PERSONNELLES (SOLO SHOWS)
            </h3>
            <ul class="space-y-4 text-xs font-sans">
              {soloExhibitions.map((item) => (
                <li class="border-b border-hairline pb-3">
                  <span class="font-mono text-[10px] text-[#8C7A5E] font-bold block">{item.year}</span>
                  <span class="font-bold text-[#141413] block">{item.title}</span>
                  <span class="text-[#666460]">{item.location}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Group Shows -->
          <div class="space-y-4">
            <h3 class="text-xs font-mono uppercase tracking-[0.2em] text-[#8C7A5E] font-bold border-b border-hairline pb-2">
              EXPOSITIONS COLLECTIVES (GROUP SHOWS)
            </h3>
            <ul class="space-y-4 text-xs font-sans">
              {groupExhibitions.map((item) => (
                <li class="border-b border-hairline pb-3">
                  <span class="font-mono text-[10px] text-[#8C7A5E] font-bold block">{item.year}</span>
                  <span class="font-bold text-[#141413] block">{item.title}</span>
                  <span class="text-[#666460]">{item.location}</span>
                </li>
              ))}
            </ul>
          </div>

        </div>

      </div>

    </div>
  </section>
</BaseLayout>
