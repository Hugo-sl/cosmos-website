---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { ArrowUpRight, ChevronLeft, ChevronRight } from '@lucide/astro';

import imgTheWall from '../assets/oeuvres/THE-WALL.webp';
import imgCubaLibre from '../assets/oeuvres/CUBA-LIBRE.webp';
import imgSierraNevada from '../assets/oeuvres/SIERRA NEVADA 80X80.webp';
import imgStonedAgain from '../assets/oeuvres/STONED-AGAIN.webp';
import imgRomeoJuliette from '../assets/oeuvres/ROMEO-_-JULIETTE.webp';

const featuredArtworks = [
  {
    id: "the-wall",
    fig: "01",
    title: "The Wall",
    year: "2024",
    medium: "Technique mixte, spray aérosol & typographies sur lin",
    dimensions: "120 × 100 cm",
    status: "Disponible",
    image: imgTheWall,
  },
  {
    id: "cuba-libre",
    fig: "02",
    title: "Cuba Libre",
    year: "2024",
    medium: "Acrylique, spray & dripping monumental",
    dimensions: "100 × 100 cm",
    status: "Collection Privée",
    image: imgCubaLibre,
  },
  {
    id: "sierra-nevada",
    fig: "03",
    title: "Sierra Nevada",
    year: "2024",
    medium: "Huile, spray & pigments purs sur toile",
    dimensions: "80 × 80 cm",
    status: "Disponible",
    image: imgSierraNevada,
  },
  {
    id: "stoned-again",
    fig: "04",
    title: "Stoned Again",
    year: "2024",
    medium: "Collage urbain, déchirures & résine mate",
    dimensions: "100 × 100 cm",
    status: "Disponible",
    image: imgStonedAgain,
  },
  {
    id: "romeo-juliette",
    fig: "05",
    title: "Roméo & Juliette",
    year: "2024",
    medium: "Diptyque gestuel, aérosol & huile sur lin",
    dimensions: "140 × 100 cm",
    status: "Collection Privée",
    image: imgRomeoJuliette,
  },
];
---

<BaseLayout
  title="Accueil V2 — Monographie & Immersion Plein Écran"
  description="Expérience d'immersion totale plein écran dans l'univers pictural de COSMOS. Action Painting & Street Art contemporain."
  currentPath="/accueil-v2"
>

  <!-- ═══════════════════════════════════════════════════════════════
       HERO SECTION — DIRECTION 1: LA MONOGRAPHIE HAUTE-COUTURE
       ═══════════════════════════════════════════════════════════════ -->
  <section
    id="hero-v2"
    class="relative h-[100dvh] min-h-[600px] w-full overflow-hidden select-none bg-[#F9F8F5]"
  >
    <!-- 1. Full-Bleed Artwork Canvases (100% of the screen, clean & luminous) -->
    {featuredArtworks.map((art, idx) => (
      <div
        class={`hero-canvas-layer absolute inset-0 transition-opacity duration-1000 ease-[cubic-bezier(0.32,0.72,0,1)] ${
          idx === 0 ? 'opacity-100 z-1 pointer-events-auto' : 'opacity-0 z-0 pointer-events-none'
        }`}
        data-canvas-idx={idx}
      >
        <Image
          src={art.image}
          alt={`COSMOS — ${art.title}`}
          class="w-full h-full object-cover hero-kenburns"
          width={1920}
          height={1080}
          loading={idx === 0 ? "eager" : "lazy"}
          aria-hidden={idx !== 0}
        />
      </div>
    ))}

    <!-- 2. Subtle Museum Lighting Glow -->
    <div id="hero-spotlight" class="absolute inset-0 z-10 pointer-events-none opacity-0 transition-opacity duration-700" />

    <!-- 3. Museum Paper Vignettes (#F9F8F5) -->
    <!-- Top light paper gradient strictly confined to navbar height (80-100px) for clean menu legibility -->
    <div class="absolute inset-x-0 top-0 h-24 sm:h-28 z-15 bg-gradient-to-b from-[#F9F8F5]/90 via-[#F9F8F5]/50 to-transparent pointer-events-none" />

    <!-- Bottom-up paper gradient for curatorial bar, merging into the next section -->
    <div class="absolute inset-x-0 bottom-0 h-60 sm:h-56 lg:h-52 z-15 bg-gradient-to-t from-[#F9F8F5] via-[#F9F8F5]/85 via-45% via-[#F9F8F5]/30 via-75% to-transparent pointer-events-none" />

    <!-- 4. Bottom Horizontal Curatorial Baseline (Continuous Haute-Couture Reel in Museum Paper Theme) -->
    <div id="hero-bottom-bar" class="relative z-30 h-full max-w-[1600px] mx-auto px-6 sm:px-12 pb-7 sm:pb-9 flex flex-col justify-end pointer-events-none">
      
      <div class="flex flex-col xl:flex-row items-start xl:items-end justify-between gap-6 w-full pt-4 border-t border-[#141413]/15">

        <!-- Left: Artist Identity (H1) + Curatorial Cartel (Diptych) -->
        <div class="pointer-events-auto flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6 shrink-0">
          
          <!-- Bloc 1: Artist Monograph Signature (H1) -->
          <div class="space-y-0.5">
            <h1 class="font-serif-display text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-[#141413] leading-none">
              COSMOS
            </h1>
            <p class="text-[9px] sm:text-[10px] font-mono uppercase tracking-[0.25em] text-[#8C7A5E] font-bold">
              Action Painting · Art Urbain Contemporain
            </p>
          </div>

          <!-- Vertical Hairline Divider -->
          <div class="hidden sm:block w-px h-11 sm:h-14 bg-[#141413]/15 self-center shrink-0" aria-hidden="true" />

          <!-- Bloc 2: Current Artwork Cartel -->
          <div class="space-y-0.5 sm:space-y-1 border-t sm:border-t-0 border-[#141413]/10 pt-2 sm:pt-0">
            <span id="cartel-meta" class="block text-[10.5px] sm:text-[11px] font-mono uppercase tracking-[0.22em] text-[#8C7A5E] font-bold">
              01 / 05
            </span>
            <h2 id="cartel-title" class="font-serif-display text-xl sm:text-2xl lg:text-3xl font-bold tracking-tight text-[#141413] leading-none transition-all duration-200">
              The Wall
            </h2>
            <p id="cartel-specs" class="text-[11px] sm:text-xs font-mono text-[#666460]">
              2024 · 120 × 100 cm · Technique mixte sur lin
            </p>
          </div>

        </div>

        <!-- Right: Pure Typographic Stepper (Zero container, bare editorial harmony) -->
        <div class="pointer-events-auto flex items-center gap-4 sm:gap-6 self-start md:self-end pt-3 md:pt-0 shrink-0">
          
          <!-- Prev Arrow -->
          <button
            id="btn-prev-art"
            type="button"
            aria-label="Œuvre précédente"
            class="group p-1 text-[#141413]/40 hover:text-[#141413] transition-colors cursor-pointer"
          >
            <ChevronLeft class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-0.5" />
          </button>

          <!-- Numbered Editorial Steppers -->
          <div class="flex items-center gap-3 sm:gap-4">
            {featuredArtworks.map((art, idx) => (
              <button
                type="button"
                class={`curatorial-reel-btn group relative py-1 text-xs sm:text-[13px] font-mono tracking-widest transition-all duration-300 cursor-pointer ${
                  idx === 0
                    ? 'text-[#141413] font-bold'
                    : 'text-[#141413]/35 hover:text-[#141413] font-normal'
                }`}
                data-reel-index={idx}
                aria-label={`Afficher l'œuvre ${art.fig} : ${art.title}`}
              >
                <span>{art.fig}</span>
                <!-- Active Underline Hairline Indicator -->
                <span
                  class={`stepper-line absolute -bottom-0.5 inset-x-0 h-0.5 transition-all duration-300 ${
                    idx === 0 ? 'bg-[#8C7A5E] opacity-100 scale-x-100' : 'bg-[#8C7A5E] opacity-0 scale-x-0 group-hover:opacity-40 group-hover:scale-x-75'
                  }`}
                  aria-hidden="true"
                />
              </button>
            ))}
          </div>

          <!-- Next Arrow -->
          <button
            id="btn-next-art"
            type="button"
            aria-label="Œuvre suivante"
            class="group p-1 text-[#141413]/40 hover:text-[#141413] transition-colors cursor-pointer"
          >
            <ChevronRight class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" />
          </button>

        </div>

      </div>

    </div>

  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       2. EXHIBITION DETAILS SECTION
       ═══════════════════════════════════════════════════════════════ -->
  <section id="exhibition-details" class="py-16 sm:py-24 lg:py-32 bg-[#F9F8F5] border-b border-hairline">
    <div class="max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <div class="lg:col-span-6 space-y-4 sm:space-y-6">
          <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#8C7A5E] font-bold block">
            L'EXPÉRIENCE DU GESTE
          </span>
          <h2 class="font-serif-display text-3xl sm:text-5xl lg:text-6xl text-[#141413] font-bold tracking-tight leading-[0.95]">
            La Fusion des Deux Mondes
          </h2>
          <p class="text-xs sm:text-sm text-[#666460] font-light leading-relaxed">
            L'artiste aborde chaque toile comme un sanctuaire d'énergie. Des strates de bombes aérosol aux coulures à l'huile, l'œuvre capture l'urgence de la rue et la pérennité du musée.
          </p>
          <div class="pt-2">
            <a
              href="/a-propos"
              class="inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.2em] text-[#141413] hover:text-[#8C7A5E] transition-colors border-b border-[#141413] pb-1 font-bold"
            >
              <span>Lire la biographie curatoriale</span>
              <ArrowUpRight class="w-3.5 h-3.5" aria-hidden="true" />
            </a>
          </div>
        </div>
        <div class="lg:col-span-6 grid grid-cols-2 gap-3 sm:gap-4 mt-4 lg:mt-0">
          <div class="aspect-[3/4] bg-[#F2F0EB] border border-hairline overflow-hidden">
            <Image src={imgCubaLibre} alt="COSMOS — Cuba Libre" class="w-full h-full object-cover img-museum" width={600} height={800} />
          </div>
          <div class="aspect-[3/4] bg-[#F2F0EB] border border-hairline overflow-hidden mt-4 sm:mt-8">
            <Image src={imgSierraNevada} alt="COSMOS — Sierra Nevada" class="w-full h-full object-cover img-museum" width={600} height={800} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════
       3. ATELIER & CONTACT CTA
       ═══════════════════════════════════════════════════════════════ -->
  <section class="py-16 sm:py-24 bg-[#141413] text-[#F9F8F5]">
    <div class="max-w-[1200px] mx-auto px-6 text-center space-y-6 sm:space-y-8">
      <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#8C7A5E] font-bold block">
        RÉSERVATIONS & GALERIES
      </span>
      <h2 class="font-serif-display text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight">
        Visite Privée de l'Atelier
      </h2>
      <p class="text-xs sm:text-sm text-[#9C9991] font-light max-w-xl mx-auto leading-relaxed">
        Découvrez les nouvelles créations en avant-première et étudiez la réalisation d'œuvres sur-mesure avec l'artiste.
      </p>
      <div class="pt-2 sm:pt-4">
        <a
          href="/contact"
          class="inline-flex items-center justify-center gap-2.5 sm:gap-3 px-6 sm:px-8 py-3.5 sm:py-4 bg-[#F9F8F5] text-[#141413] text-[11px] sm:text-xs font-mono uppercase tracking-[0.2em] font-bold hover:bg-[#8C7A5E] hover:text-[#F9F8F5] transition-colors"
        >
          <span>Prendre rendez-vous au studio</span>
          <ArrowUpRight class="w-3.5 h-3.5 sm:w-4 sm:h-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Gentle continuous slow zoom on active canvas */
  @keyframes kenburns {
    0%   { transform: scale(1) translate(0, 0); }
    50%  { transform: scale(1.05) translate(-0.8%, -0.4%); }
    100% { transform: scale(1) translate(0, 0); }
  }
  .hero-kenburns {
    animation: kenburns 30s ease-in-out infinite;
  }
</style>

<script define:vars={{ featuredArtworks }}>
  let activeIndex = 0;
  const totalArtworks = featuredArtworks.length;
  let autoplayTimer = null;

  const canvasLayers = document.querySelectorAll('.hero-canvas-layer');
  const reelBtns = document.querySelectorAll('.curatorial-reel-btn');

  const cartelMeta = document.getElementById('cartel-meta');
  const cartelTitle = document.getElementById('cartel-title');
  const cartelSpecs = document.getElementById('cartel-specs');

  const btnPrev = document.getElementById('btn-prev-art');
  const btnNext = document.getElementById('btn-next-art');
  const heroSection = document.getElementById('hero-v2');
  const heroBottomBar = document.getElementById('hero-bottom-bar');

  function updateArtwork(index) {
    if (index < 0) index = totalArtworks - 1;
    if (index >= totalArtworks) index = 0;
    activeIndex = index;

    const data = featuredArtworks[activeIndex];

    // 1. Cross-fade background canvases
    canvasLayers.forEach((layer, i) => {
      if (i === activeIndex) {
        layer.classList.add('opacity-100', 'z-1', 'pointer-events-auto');
        layer.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
      } else {
        layer.classList.remove('opacity-100', 'z-1', 'pointer-events-auto');
        layer.classList.add('opacity-0', 'z-0', 'pointer-events-none');
      }
    });

    // 2. Update reel active button styling
    reelBtns.forEach((btn, i) => {
      const line = btn.querySelector('.stepper-line');
      if (i === activeIndex) {
        btn.classList.add('text-[#141413]', 'font-bold');
        btn.classList.remove('text-[#141413]/35', 'font-normal');
        if (line) {
          line.classList.add('opacity-100', 'scale-x-100');
          line.classList.remove('opacity-0', 'scale-x-0');
        }
      } else {
        btn.classList.remove('text-[#141413]', 'font-bold');
        btn.classList.add('text-[#141413]/35', 'font-normal');
        if (line) {
          line.classList.remove('opacity-100', 'scale-x-100');
          line.classList.add('opacity-0', 'scale-x-0');
        }
      }
    });

    // 3. Update typographic cartel
    if (cartelMeta) cartelMeta.textContent = `${data.fig} / 05`;
    if (cartelTitle) {
      cartelTitle.style.opacity = '0';
      cartelTitle.style.transform = 'translateY(4px)';
      setTimeout(() => {
        cartelTitle.textContent = data.title;
        cartelTitle.style.opacity = '1';
        cartelTitle.style.transform = 'translateY(0)';
      }, 150);
    }
    if (cartelSpecs) cartelSpecs.textContent = `${data.year} · ${data.dimensions} · ${data.medium}`;
  }

  // Reel buttons click
  reelBtns.forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const idx = parseInt(btn.getAttribute('data-reel-index') || '0', 10);
      updateArtwork(idx);
      resetAutoplay();
    });
  });

  if (btnPrev) {
    btnPrev.addEventListener('click', (e) => {
      e.stopPropagation();
      updateArtwork(activeIndex - 1);
      resetAutoplay();
    });
  }

  if (btnNext) {
    btnNext.addEventListener('click', (e) => {
      e.stopPropagation();
      updateArtwork(activeIndex + 1);
      resetAutoplay();
    });
  }

  window.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') {
      updateArtwork(activeIndex + 1);
      resetAutoplay();
    } else if (e.key === 'ArrowLeft') {
      updateArtwork(activeIndex - 1);
      resetAutoplay();
    }
  });

  function startAutoplay() {
    autoplayTimer = setInterval(() => {
      updateArtwork(activeIndex + 1);
    }, 8000);
  }

  function resetAutoplay() {
    clearInterval(autoplayTimer);
    startAutoplay();
  }

  startAutoplay();

  if (heroBottomBar) {
    heroBottomBar.addEventListener('mouseenter', () => clearInterval(autoplayTimer));
    heroBottomBar.addEventListener('mouseleave', () => resetAutoplay());
  }

  // Subtle mouse spotlight
  const spotlight = document.getElementById('hero-spotlight');
  if (heroSection && spotlight) {
    heroSection.addEventListener('mouseenter', () => {
      spotlight.style.opacity = '1';
    });
    heroSection.addEventListener('mouseleave', () => {
      spotlight.style.opacity = '0';
    });
    heroSection.addEventListener('mousemove', (e) => {
      const rect = heroSection.getBoundingClientRect();
      const x = e.clientX - rect.left;
      const y = e.clientY - rect.top;
      spotlight.style.background = `radial-gradient(600px circle at ${x}px ${y}px, rgba(255,255,255,0.06), transparent 70%)`;
    });
  }
</script>
