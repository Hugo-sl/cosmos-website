---
import { Image } from 'astro:assets';
import { MapPin, ArrowUpRight } from '@lucide/astro';
import imgAssilah from '../assets/oeuvres/SIERRA NEVADA 80X80.webp';
---

<section aria-label="Visite de l'Atelier" class="py-24 bg-[#141413] text-[#F9F8F5] relative overflow-hidden">
  <div class="max-w-[1600px] mx-auto px-6 sm:px-10 lg:px-16">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Text Information Column -->
      <div class="lg:col-span-7 space-y-8">
        <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-[#8C7A5E] block font-bold">
          VISITER L'ATELIER
        </span>

        <h2 class="font-serif-display text-4xl sm:text-6xl text-[#F9F8F5] font-bold tracking-tight leading-[0.9]">
          Entrez dans l'univers de COSMOS
        </h2>

        <div class="space-y-4 text-sm sm:text-base text-[#9C9991] font-light leading-relaxed max-w-2xl">
          <p class="text-[#F9F8F5] font-normal italic">
            Là où la couleur prend forme, où les gestes se superposent et où chaque toile devient un territoire à explorer.
          </p>
          <p>
            L'atelier de COSMOS est le lieu où naissent les œuvres, entre mouvement, matière et énergie. Un espace vivant, ouvert aux rencontres, aux projets singuliers et aux œuvres pensées pour des lieux qui leur ressemblent.
          </p>
        </div>

        <div class="border-t border-hairline-dark pt-6">
          <div class="space-y-1.5">
            <div class="flex items-center gap-2 text-xs font-mono uppercase tracking-[0.18em] text-[#8C7A5E] font-bold">
              <MapPin class="w-4 h-4" aria-hidden="true" />
              <span>LOCALISATION</span>
            </div>
            <p class="text-xs text-[#9C9991] font-light">
              Le Kremlin-Bicêtre (Grand Paris) — Visites sur rendez-vous.
            </p>
          </div>
        </div>

        <div class="pt-4">
          <a
            href="/contact"
            class="inline-flex items-center gap-3 px-8 py-4 bg-[#F9F8F5] text-[#141413] text-xs font-mono uppercase tracking-[0.2em] font-bold hover:bg-[#8C7A5E] hover:text-[#F9F8F5] transition-all duration-300"
          >
            <span>Découvrir l'Atelier</span>
            <ArrowUpRight class="w-4 h-4" aria-hidden="true" />
          </a>
        </div>
      </div>

      <!-- Image Column -->
      <div class="lg:col-span-5">
        <div class="aspect-square bg-[#121211] border border-hairline-dark overflow-hidden relative">
          <Image
            src={imgAssilah}
            alt="COSMOS — Vue de l'atelier au Kremlin-Bicêtre"
            class="w-full h-full object-cover img-museum opacity-90"
            width={700}
            height={700}
          />
          <div class="absolute bottom-4 left-4 right-4 bg-[#141413]/90 backdrop-blur-md p-4 border border-hairline-dark text-[10px] font-mono text-[#9C9991]">
            <span class="text-[#8C7A5E] uppercase block font-bold tracking-[0.18em]">ATELIER — LE KREMLIN-BICÊTRE</span>
            <span>Espace de création & accompagnement sur-mesure pour galeries & projets d'exception</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
