      </svg>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Navigation principale" class="hidden md:flex items-center gap-8">
      
      <!-- Accueil Dropdown (V1 vs V2 vs V3) -->
      <div class="relative group py-1">
        <a
          href="/"
          class={`text-xs uppercase tracking-[0.2em] font-sans font-medium transition-all flex items-center gap-1.5 ${
            isDarkHeader
              ? 'text-[#F9F8F5] font-semibold'
              : isCurrent('/') ? 'text-[#141413] font-semibold' : 'text-[#666460] hover:text-[#141413]'
          }`}
        >
          <span>Accueil ({getAccueilLabel()})</span>
          <ChevronDown class={`w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-300 ${
            isDarkHeader ? 'text-[#C4B59D]' : 'text-[#8C7A5E]'
          }`} aria-hidden="true" />
        </a>

        <!-- Dropdown Menu -->
        <div class={`absolute top-full left-0 hidden group-hover:flex flex-col border p-3 shadow-2xl min-w-[220px] space-y-1 ${
          isDarkHeader
            ? 'bg-[#141413]/95 backdrop-blur-xl border-white/20 text-[#F9F8F5]'
            : 'bg-[#F9F8F5] border-hairline text-[#141413]'
        }`}>
          <a href="/" class={`text-xs font-mono py-2 px-3 transition-colors flex items-center justify-between ${
            isDarkHeader ? 'hover:bg-white/10 text-[#9C9991]' : 'hover:bg-[#F2F0EB] text-[#666460]'
          } ${currentPath === '/' ? 'font-bold text-[#F9F8F5]' : ''}`}>
            <span>V1. Écrin Muséal</span>
            <span class="text-[9px] text-[#C4B59D]">Classique</span>
          </a>
          <a href="/accueil-v2" class={`text-xs font-mono py-2 px-3 transition-colors flex items-center justify-between ${
            isDarkHeader ? 'hover:bg-white/10 text-[#9C9991]' : 'hover:bg-[#F2F0EB] text-[#666460]'
          } ${currentPath === '/accueil-v2' ? 'font-bold text-[#F9F8F5]' : ''}`}>
            <span>V2. Hero Plein Écran</span>
            <span class="text-[9px] text-[#C4B59D]">Immersif</span>
          </a>
          <a href="/accueil-v3" class={`text-xs font-mono py-2 px-3 transition-colors flex items-center justify-between ${
            isDarkHeader ? 'hover:bg-white/10 text-[#9C9991]' : 'hover:bg-[#F2F0EB] text-[#666460]'
          } ${currentPath === '/accueil-v3' ? 'font-bold text-[#F9F8F5]' : ''}`}>
            <span>V3. Tunnel 3D</span>
            <span class="text-[9px] text-[#C4B59D]">Perspective 3D</span>
          </a>
        </div>
      </div>

      <!-- Galerie Dropdown with all 4 versions -->
      <div class="relative group py-1">
        <a
          href="/galerie"
          class={`text-xs uppercase tracking-[0.2em] font-sans font-medium transition-all flex items-center gap-1.5 ${
            isDarkHeader
              ? 'text-[#F9F8F5]/80 hover:text-[#F9F8F5]'
              : isGalerieActive ? 'text-[#141413] font-semibold' : 'text-[#666460] hover:text-[#141413]'
          }`}
        >
          <span>Galeries ({getGalerieLabel()})</span>
          <ChevronDown class={`w-3.5 h-3.5 group-hover:rotate-180 transition-transform duration-300 ${
            isDarkHeader ? 'text-[#C4B59D]' : 'text-[#8C7A5E]'
          }`} aria-hidden="true" />
        </a>

        <!-- Dropdown Menu -->
        <div class={`absolute top-full left-0 hidden group-hover:flex flex-col border p-3 shadow-2xl min-w-[220px] space-y-1 ${
          isDarkHeader
            ? 'bg-[#141413]/95 backdrop-blur-xl border-white/20 text-[#F9F8F5]'
            : 'bg-[#F9F8F5] border-hairline text-[#141413]'
        }`}>
          <a href="/galerie" class={`text-xs font-mono py-2 px-3 transition-colors flex items-center justify-between ${
            isDarkHeader ? 'hover:bg-white/10 text-[#9C9991]' : 'hover:bg-[#F2F0EB] text-[#666460]'
          } ${currentPath === '/galerie' ? 'font-bold text-[#F9F8F5]' : ''}`}>
            <span>V1. Catalogue Grille</span>
            <span class="text-[9px] text-[#C4B59D]">Classique</span>
          </a>
          <a href="/galerie-v2" class={`text-xs font-mono py-2 px-3 transition-colors flex items-center justify-between ${
            isDarkHeader ? 'hover:bg-white/10 text-[#9C9991]' : 'hover:bg-[#F2F0EB] text-[#666460]'
          } ${currentPath === '/galerie-v2' ? 'font-bold text-[#F9F8F5]' : ''}`}>
            <span>V2. Wall Slider In Situ</span>
            <span class="text-[9px] text-[#C4B59D]">Horizontal</span>
          </a>
          <a href="/galerie-v3" class={`text-xs font-mono py-2 px-3 transition-colors flex items-center justify-between ${
            isDarkHeader ? 'hover:bg-white/10 text-[#9C9991]' : 'hover:bg-[#F2F0EB] text-[#666460]'
          } ${currentPath === '/galerie-v3' ? 'font-bold text-[#F9F8F5]' : ''}`}>
            <span>V3. Scroll Vertical</span>
            <span class="text-[9px] text-[#C4B59D]">Parallax</span>
          </a>
          <a href="/galerie-v4" class={`text-xs font-mono py-2 px-3 transition-colors flex items-center justify-between ${
            isDarkHeader ? 'hover:bg-white/10 text-[#9C9991]' : 'hover:bg-[#F2F0EB] text-[#666460]'
          } ${currentPath === '/galerie-v4' ? 'font-bold text-[#F9F8F5]' : ''}`}>
            <span>V4. Backdrop Atmosphere</span>
            <span class="text-[9px] text-[#C4B59D]">Atmosphère</span>
          </a>
        </div>
      </div>

      <a
        href="/a-propos"
        class={`text-xs uppercase tracking-[0.2em] font-sans font-medium transition-all relative py-1 ${
          isDarkHeader
            ? 'text-[#F9F8F5]/80 hover:text-[#F9F8F5]'
            : isCurrent('/a-propos') ? 'text-[#141413] font-semibold' : 'text-[#666460] hover:text-[#141413]'
        }`}
      >
        Démarche & Bio
      </a>

      <a
        href="/contact"
        class={`text-xs uppercase tracking-[0.2em] font-sans font-medium transition-all relative py-1 ${
          isDarkHeader
            ? 'text-[#F9F8F5]/80 hover:text-[#F9F8F5]'
            : isCurrent('/contact') ? 'text-[#141413] font-semibold' : 'text-[#666460] hover:text-[#141413]'
        }`}
      >
        Atelier & Contact
      </a>
    </nav>

    <!-- Professional Inquiries Action -->
    <a
      href="/contact"
      class={`hidden md:inline-flex items-center gap-2 text-xs font-mono uppercase tracking-[0.18em] px-4 py-2 border transition-all duration-300 ${
        isDarkHeader
          ? 'border-white/30 text-[#F9F8F5] hover:bg-[#F9F8F5] hover:text-[#141413]'
          : 'border-[#141413]/30 text-[#141413] hover:bg-[#141413] hover:text-[#F9F8F5]'
      }`}
    >
      <span>Contact Atelier</span>
      <ArrowUpRight class="w-3.5 h-3.5" aria-hidden="true" />
    </a>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-trigger"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Ouvrir le menu de navigation"
      class={`md:hidden p-2 focus:outline-none ${isDarkHeader ? 'text-[#F9F8F5]' : 'text-[#141413]'}`}
    >
      <Menu id="icon-menu-open" class="w-6 h-6 block" aria-hidden="true" />
      <X id="icon-menu-close" class="w-6 h-6 hidden" aria-hidden="true" />
    </button>
  </div>

